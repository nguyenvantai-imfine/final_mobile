<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_checking_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_surface">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_checking_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tdt_surface_container_lowest"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back_checking"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/tdt_on_surface" />

            <TextView
                android:id="@+id/tv_checking_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="B01 • Chi Tiết Tài Khoản Thanh Toán"
                android:textColor="@color/tdt_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_more_checking"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Thao tác"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/tdt_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_checking_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Hero Account Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_checking_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tdt_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card_gradient"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:alpha="0.12"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/tdt_on_primary" />

                    <!-- Badges Row -->
                    <LinearLayout
                        android:id="@+id/row_checking_hero_badges"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_translucent_white"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Tài khoản thanh toán"
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_translucent_white"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_primary_fixed"
                                android:backgroundTint="#2E9E5B" />

                            <TextView
                                android:id="@+id/tv_checking_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Đang hoạt động"
                                android:textColor="@color/tdt_on_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Account Number + Copy -->
                    <LinearLayout
                        android:id="@+id/row_checking_acc_number"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/row_checking_hero_badges">

                        <TextView
                            android:id="@+id/tv_checking_detail_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:letterSpacing="0.06"
                            android:text="1903 8888 6666"
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btn_copy_checking_detail"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_translucent_white"
                            android:contentDescription="Sao chép số tài khoản"
                            android:padding="5dp"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/tdt_on_primary" />
                    </LinearLayout>

                    <!-- Available Balance + Toggle -->
                    <LinearLayout
                        android:id="@+id/row_checking_balance_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/row_checking_acc_number">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số dư khả dụng"
                            android:textColor="@color/tdt_on_primary_container"
                            android:textSize="11sp" />

                        <ImageButton
                            android:id="@+id/btn_toggle_checking_balance"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Ẩn hiện số dư"
                            android:padding="3dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/tdt_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_checking_balance_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/row_checking_balance_label">

                        <TextView
                            android:id="@+id/tv_checking_detail_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:letterSpacing="-0.02"
                            android:text="15.850.000"
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:alpha="0.85"
                            android:text="đ"
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Secondary Balances Mini-bar -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_pill_translucent_white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/row_checking_balance_value">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.75"
                            android:text="Số dư thực tế: "
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_checking_actual_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:text="15.900.000 đ"
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.75"
                            android:text="Phong tỏa: "
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_checking_hold_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:text="50.000 đ"
                            android:textColor="@color/tdt_on_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Quick Action Buttons (4 Columns) -->
            <LinearLayout
                android:id="@+id/row_checking_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- Chuyển tiền -->
                <LinearLayout
                    android:id="@+id/btn_action_transfer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_primary_fixed"
                        android:backgroundTint="@color/tdt_primary_container">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/tdt_on_primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Chuyển tiền"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quét QR -->
                <LinearLayout
                    android:id="@+id/btn_action_scan_qr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_surface_low"
                        android:backgroundTint="@color/tdt_surface_container_lowest">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/tdt_primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Quét QR"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Nạp tiền -->
                <LinearLayout
                    android:id="@+id/btn_action_deposit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_surface_low"
                        android:backgroundTint="@color/tdt_surface_container_lowest">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="@color/tdt_primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Nạp tiền"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quản lý thẻ -->
                <LinearLayout
                    android:id="@+id/btn_action_manage_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_surface_low"
                        android:backgroundTint="@color/tdt_surface_container_lowest">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="@color/tdt_primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Quản lý thẻ"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Account Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_checking_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thông tin tài khoản"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_circle_primary_fixed"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Cá nhân"
                            android:textColor="@color/tdt_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chủ tài khoản -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chủ tài khoản"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_checking_owner_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NGUYỄN VĂN TÀI"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chi nhánh -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chi nhánh mở TK"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_checking_branch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TDTU - CN Tân Phong, Q.7"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ngày mở tài khoản -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày mở tài khoản"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_checking_opened_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15/09/2021"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hạn mức chuyển/ngày -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hạn mức chuyển/ngày"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_checking_daily_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:text="500.000.000 đ"
                            android:textColor="@color/tdt_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Linked Debit Card Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_12_surface_low"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Thẻ ghi nợ liên kết"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_soft_badge_green"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Đang liên kết"
                                android:textColor="#2E9E5B"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_linked_debit_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Visa Platinum •••• 4289"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Thanh toán trực tuyến (E-Commerce)"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="12sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switch_online_payment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Transaction Search & Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Biến động số dư"
                    android:textColor="@color/tdt_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_advanced_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="Bộ lọc nâng cao"
                    android:textColor="@color/tdt_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_search_checking_tx"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_normal"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:hint="Tìm kiếm theo người nhận, nội dung..."
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/tdt_on_surface"
                android:textColorHint="@color/tdt_outline"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_tx_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tx_all"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tất cả" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tx_in"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền vào (+)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tx_out"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền ra (-)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tx_7d"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 ngày" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tx_month"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tháng này" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 5. Recent Transactions List Container (RecyclerView) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_checking_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_checking_transactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="4" />

                    <TextView
                        android:id="@+id/tv_empty_checking_tx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="Chưa có biến động số dư phù hợp"
                        android:textColor="@color/tdt_on_surface_variant"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Statement Export CTA & Security Footer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_statement"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Xem sao kê điện tử / Xuất PDF"
                android:textAllCaps="false"
                android:textColor="@color/tdt_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tdt_surface_container_lowest"
                app:cornerRadius="12dp"
                app:strokeColor="@color/tdt_neutral_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_24"
                    app:tint="@color/tdt_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Được bảo vệ bởi TDT Bank Shield • PCI-DSS Level 1"
                    android:textColor="@color/tdt_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>