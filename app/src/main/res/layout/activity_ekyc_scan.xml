<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_ekyc_scan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_inverse_surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_ekyc_scan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <!-- Top Navigation Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_ekyc_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_translucent_white"
                    android:contentDescription="Đóng xác thực"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_ekyc_scan_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ekyc_scan_title"
                        android:textColor="@color/tdt_inverse_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ekyc_scan_subtitle_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="● eKYC TDT Shield 3.0"
                        android:textColor="@color/tdt_on_primary_container"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_ekyc_toggle_torch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_translucent_white"
                    android:contentDescription="Bật đèn trợ sáng"
                    android:src="@drawable/ic_flashlight_on_24"
                    app:tint="@color/tdt_inverse_on_surface" />
            </RelativeLayout>

            <!-- Live Stage / Biometric Scan Frame -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- Oval Biometric Scanner Container -->
                <FrameLayout
                    android:id="@+id/frame_ekyc_oval_container"
                    android:layout_width="240dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_ekyc_oval_ring"
                    android:padding="3dp">

                    <FrameLayout
                        android:id="@+id/frame_ekyc_camera_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_ekyc_oval_inner">

                        <!-- Face Landmark Mesh Guide -->
                        <ImageView
                            android:id="@+id/iv_ekyc_face_guide"
                            android:layout_width="192dp"
                            android:layout_height="248dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_ekyc_face_mesh" />

                        <!-- Biometric Laser Scan Line -->
                        <View
                            android:id="@+id/view_ekyc_scan_line"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="top"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_ekyc_scan_laser" />

                        <!-- Right Pulse Indicator -->
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/tdt_secondary_container" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Floating Progress Capsule -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_badge_security"
                    android:backgroundTint="@color/tdt_tertiary_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_primary"
                        android:backgroundTint="@color/tdt_secondary_container" />

                    <TextView
                        android:id="@+id/tv_ekyc_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/ekyc_scanning_progress"
                        android:textColor="@color/tdt_surface_bright"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Interactive Instruction Card -->
            <LinearLayout
                android:id="@+id/card_ekyc_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_12_surface_low"
                android:backgroundTint="#33E2E2E4"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_8_surface_container"
                        android:backgroundTint="#4DA50064">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_face_retouching" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ekyc_next_action_label"
                            android:textColor="@color/tdt_outline_variant"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ekyc_instruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/ekyc_instruction_action"
                            android:textColor="@color/tdt_surface_bright"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Head Turn Angle Mini Visual Meter -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_visibility"
                            app:tint="@color/tdt_secondary_container" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/ekyc_eye_movement_sensor"
                            android:textColor="@color/tdt_outline_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/ekyc_rotation_angle"
                        android:textColor="@color/tdt_secondary_fixed"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Liveness Step Progress Tracker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_12_surface_low"
                android:backgroundTint="#40E8E8EA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Step 1: Done -->
                <LinearLayout
                    android:id="@+id/step_ekyc_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_circle_primary"
                        android:backgroundTint="#33FE4EA9">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ekyc_step_1_title"
                            android:textColor="@color/tdt_surface_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ekyc_step_1_done"
                            android:textColor="@color/tdt_secondary_fixed"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="14dp"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#4DDEBEC8" />

                <!-- Step 2: In-Progress -->
                <LinearLayout
                    android:id="@+id/step_ekyc_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_circle_primary"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/tdt_on_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ekyc_step_2_title"
                            android:textColor="@color/tdt_secondary_fixed"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ekyc_step_2_scanning"
                            android:textColor="@color/tdt_secondary_container"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="14dp"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#4DDEBEC8" />

                <!-- Step 3: Pending -->
                <LinearLayout
                    android:id="@+id/step_ekyc_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_circle_primary"
                        android:backgroundTint="@color/tdt_surface_variant"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/tdt_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ekyc_step_3_title"
                            android:textColor="@color/tdt_surface_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ekyc_step_3_pending"
                            android:textColor="@color/tdt_outline_variant"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Security & Compliance Disclaimer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_verified_user"
                    app:tint="@color/tdt_secondary_container" />

                <TextView
                    android:id="@+id/tv_ekyc_scan_disclaimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/ekyc_scan_disclaimer"
                    android:textColor="@color/tdt_surface_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Secondary Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ekyc_other_method"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/ekyc_btn_other_method"
                android:textAllCaps="false"
                android:textColor="@color/tdt_surface_bright"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#99E8E8EA"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_swap_horiz_24"
                app:iconGravity="textStart"
                app:iconTint="@color/tdt_secondary_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ekyc_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="@string/ekyc_btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/tdt_outline_variant"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
