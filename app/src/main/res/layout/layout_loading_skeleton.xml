<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_skeleton_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_neutral_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Top Hero Header Skeleton with Arch Bottom -->
        <LinearLayout
            android:id="@+id/layout_skeleton_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_header_arch"
            android:backgroundTint="@color/tdt_primary_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="52dp">

            <!-- Skeleton Avatar -->
            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_skeleton_pill"
                android:backgroundTint="#33FFFFFF" />

            <!-- Skeleton Greeting & Name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="80dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_skeleton_pill"
                    android:backgroundTint="#40FFFFFF" />

                <View
                    android:layout_width="128dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_skeleton_placeholder"
                    android:backgroundTint="#4DFFFFFF" />
            </LinearLayout>

            <!-- Action Placeholders -->
            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_skeleton_pill"
                android:backgroundTint="#33FFFFFF" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_skeleton_pill"
                android:backgroundTint="#33FFFFFF" />
        </LinearLayout>

        <!-- Primary Balance Card Skeleton (Floating -32dp) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-32dp"
            app:cardBackgroundColor="@color/tdt_neutral_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/tdt_neutral_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="112dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_skeleton_pill" />
                </RelativeLayout>

                <!-- Main Balance Placeholder -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_skeleton_placeholder" />

                <!-- Secondary Info Placeholder -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="96dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_skeleton_pill" />
                </LinearLayout>

                <!-- 4 Quick Action Placeholders -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Central Real-time Status Loader Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_skeleton_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/tdt_neutral_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/tdt_neutral_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_skeleton_spinner"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/tdt_brand_primary"
                    app:indicatorSize="40dp"
                    app:trackColor="@color/tdt_primary_fixed"
                    app:trackThickness="3.5dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_skeleton_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang tải dữ liệu tài khoản..."
                        android:textColor="@color/tdt_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_skeleton_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Vui lòng chờ trong giây lát • TDT Secure"
                        android:textColor="@color/tdt_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- My Accounts Section Skeleton (2 Cards) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/tdt_neutral_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_skeleton_placeholder" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="96dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_skeleton_placeholder" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/tdt_neutral_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_skeleton_placeholder" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="96dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_skeleton_placeholder" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Recent Transactions Skeleton (3 Rows) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/tdt_neutral_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/tdt_neutral_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="128dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_placeholder" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <View
                        android:layout_width="76dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_placeholder" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="112dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_placeholder" />

                        <View
                            android:layout_width="68dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <View
                        android:layout_width="88dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_placeholder" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_placeholder" />

                        <View
                            android:layout_width="92dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <View
                        android:layout_width="64dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_placeholder" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>