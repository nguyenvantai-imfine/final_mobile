<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_ekyc_success"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_neutral_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_ekyc_success"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Top Security Assurance Capsule -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_security"
                android:backgroundTint="@color/tdt_neutral_surface"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_verified_user"
                    app:tint="@color/tdt_brand_primary" />

                <TextView
                    android:id="@+id/tv_ekyc_success_top_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/ekyc_success_top_badge"
                    android:textColor="@color/tdt_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Biometric Oval Frame with Success Glow -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="244dp"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Ambient Glow Halo behind oval -->
                <View
                    android:layout_width="190dp"
                    android:layout_height="230dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_brand_glow"
                    android:backgroundTint="#2610B981" />

                <FrameLayout
                    android:id="@+id/frame_ekyc_success_oval"
                    android:layout_width="176dp"
                    android:layout_height="224dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_ekyc_oval_success_ring"
                    android:elevation="4dp"
                    android:padding="4dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_ekyc_oval_success_inner">

                        <ImageView
                            android:id="@+id/iv_ekyc_verified_face"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Ảnh khuôn mặt đã xác thực"
                            android:padding="20dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_face_24"
                            app:tint="@color/tdt_brand_primary" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Verified Success Checkmark Badge (Top-Right) -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="#10B981"
                    android:elevation="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle_24"
                        app:tint="@color/tdt_on_primary" />
                </FrameLayout>

                <!-- Floating AI Match Percentage Badge (Bottom-Center) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="-6dp"
                    android:background="@drawable/bg_badge_security"
                    android:backgroundTint="@color/tdt_neutral_surface"
                    android:elevation="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check"
                        app:tint="#059669" />

                    <TextView
                        android:id="@+id/tv_ekyc_ai_match_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/ekyc_success_verified_pill"
                        android:textColor="#065F46"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Headline & Subtitle -->
            <TextView
                android:id="@+id/tv_ekyc_success_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ekyc_success_title"
                android:textColor="@color/tdt_brand_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ekyc_success_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/ekyc_success_desc"
                android:textColor="@color/tdt_text_secondary"
                android:textSize="14sp" />

            <!-- Verification Details Card (Sovereign Level 1 Surface) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ekyc_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/tdt_neutral_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Card Header Badge -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_soft_pink">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_badge" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ekyc_details_title"
                                    android:textColor="@color/tdt_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ekyc_details_subtitle"
                                    android:textColor="@color/tdt_text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Compliance Chip -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_badge_security"
                            android:backgroundTint="#1A10B981"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_task_alt" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/ekyc_details_compliance"
                                android:textColor="#047857"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tdt_neutral_border" />

                    <!-- Row: Full Name -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="@string/ekyc_label_fullname"
                            android:textColor="@color/tdt_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ekyc_result_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/ekyc_value_fullname"
                            android:textColor="@color/tdt_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Row: CCCD -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="@string/ekyc_label_cccd"
                            android:textColor="@color/tdt_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ekyc_result_id_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="monospace"
                            android:text="@string/ekyc_value_cccd"
                            android:textColor="@color/tdt_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Row: Timestamp -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="@string/ekyc_label_timestamp"
                            android:textColor="@color/tdt_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ekyc_result_timestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/ekyc_value_timestamp"
                            android:textColor="@color/tdt_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Row: Tech -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="@string/ekyc_label_tech"
                            android:textColor="@color/tdt_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ekyc_result_tech"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/ekyc_value_tech"
                            android:textColor="@color/tdt_brand_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Sovereign Vault Notice Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_8_surface_container"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="1dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/tdt_brand_primary" />

                        <TextView
                            android:id="@+id/tv_ekyc_vault_notice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/ekyc_vault_notice"
                            android:textColor="@color/tdt_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Action Group -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ekyc_continue_tx"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/tdt_brand_primary"
                android:text="@string/ekyc_btn_continue_tx"
                android:textAllCaps="false"
                android:textColor="@color/tdt_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="4dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconTint="@color/tdt_on_primary" />

            <!-- Auto-redirect Countdown Indicator -->
            <TextView
                android:id="@+id/tv_ekyc_auto_redirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ekyc_auto_redirect"
                android:textColor="@color/tdt_text_secondary"
                android:textSize="12sp" />

            <!-- Certifications Footnote -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_with_heart" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="TDT Shield Sovereign"
                    android:textColor="@color/tdt_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="@color/tdt_outline" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/tdt_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="PCI-DSS Certified"
                    android:textColor="@color/tdt_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
