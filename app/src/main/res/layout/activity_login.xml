<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Brand Header with Smooth Gradient & Rounded Bottom 32dp -->
        <LinearLayout
            android:id="@+id/layout_login_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_header_arch"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Top Action Bar: Language Switcher & Emergency Hotline -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/btn_lang_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_translucent_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tv_lang_vn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VN"
                        android:textColor="@color/on_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="|"
                        android:textColor="@color/on_primary_container"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_lang_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.75"
                        android:text="EN"
                        android:textColor="@color/on_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_header_hotline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_translucent_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Hotline 24/7"
                        android:src="@android:drawable/stat_sys_phone_call"
                        app:tint="@color/secondary_fixed" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Hotline 24/7"
                        android:textColor="@color/on_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Shield Logo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo TDT Bank"
                    android:src="@drawable/ic_tdt_shield_logo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TDT BANK"
                android:textColor="@color/surface_container_lowest"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Default Greeting (02a / 02b) -->
            <LinearLayout
                android:id="@+id/layout_header_greeting_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xin chào!"
                    android:textColor="@color/secondary_fixed"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Đăng nhập để tiếp tục trải nghiệm ngân hàng số an toàn"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Lockout Header State (02c - visibility="gone" mặc định) -->
            <LinearLayout
                android:id="@+id/layout_header_greeting_locked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tài khoản đang tạm khóa bảo vệ"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cơ chế tự động ngăn ngừa truy cập trái phép"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Floating Login Card Overlapping Header (-32dp) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_login_floating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-32dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#E0E0E5"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_login_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 02c Critical Security Lockout Alert Box (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/card_lockout_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_error_banner"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_pill_translucent_white"
                        android:backgroundTint="@color/error_container">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Lockout Icon"
                            android:src="@android:drawable/ic_lock_idle_lock"
                            app:tint="@color/error" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tài khoản tạm khóa an toàn"
                                android:textColor="@color/error"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_lockout_attempts_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_translucent_white"
                                android:backgroundTint="#26BA1A1A"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="5/5 lần lỗi"
                                android:textColor="@color/error"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_lockout_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Bạn đã nhập sai thông tin quá 5 lần liên tiếp. Hệ thống tạm thời khóa tính năng đăng nhập trong 30 giây để bảo vệ an toàn tài khoản của bạn."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Field 1: Email / Username Label + Status Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Email / Tên đăng nhập"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 02b Error Badge -->
                    <TextView
                        android:id="@+id/tv_email_error_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không hợp lệ"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- 02c Locked Badge -->
                    <TextView
                        android:id="@+id/tv_email_locked_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang khóa"
                        android:textColor="@color/outline"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Field 1 Input Box -->
                <LinearLayout
                    android:id="@+id/box_input_email"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_normal"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/iv_email_leading"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Email Icon"
                        android:src="@android:drawable/ic_dialog_email"
                        app:tint="@color/outline" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Nhập email hoặc số điện thoại"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_email_trailing_status"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Trạng thái Email"
                        android:src="@android:drawable/ic_delete"
                        android:visibility="gone"
                        app:tint="@color/error" />
                </LinearLayout>

                <!-- Field 2: Password Label + Status Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mật khẩu"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 02c Disabled Badge -->
                    <TextView
                        android:id="@+id/tv_password_locked_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vô hiệu hóa"
                        android:textColor="@color/error"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Field 2 Input Box -->
                <LinearLayout
                    android:id="@+id/box_input_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_normal"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/iv_password_leading"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Password Icon"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        app:tint="@color/outline" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Nhập mật khẩu"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Hiện hoặc ẩn mật khẩu"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="@color/outline" />
                </LinearLayout>

                <!-- Remember Me & Forgot Password Row -->
                <RelativeLayout
                    android:id="@+id/layout_remember_forgot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_remember_me"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:checked="true"
                        android:minHeight="0dp"
                        android:text="Ghi nhớ đăng nhập"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        app:buttonTint="@color/primary_container" />

                    <TextView
                        android:id="@+id/tv_forgot_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="4dp"
                        android:text="Quên mật khẩu?"
                        android:textColor="@color/secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- 02b Prominent Error Alert Banner (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/card_login_error_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_error_banner"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="Cảnh báo"
                        android:src="@android:drawable/stat_sys_warning"
                        app:tint="@color/error" />

                    <TextView
                        android:id="@+id/tv_login_error_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="Email hoặc mật khẩu không chính xác. Bạn còn 2 lần thử trước khi tài khoản bị tạm khóa."
                        android:textColor="@color/on_error_container"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Primary CTA: Submit Login (02a / 02b) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login_submit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/primary_container"
                    android:text="Đăng nhập"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_media_play"
                    app:iconGravity="textEnd"
                    app:iconSize="16dp"
                    app:iconTint="@color/on_primary" />

                <!-- 02c Countdown Lock Button + Progress Bar (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/layout_lockout_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_countdown_lock"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/surface_container_high"
                        android:enabled="false"
                        android:text="Vui lòng thử lại sau 00:30"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_lock_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="30"
                        android:progress="30"
                        app:indicatorColor="@color/primary_container"
                        app:trackColor="@color/surface_container_high"
                        app:trackCornerRadius="999dp"
                        app:trackThickness="6dp" />
                </LinearLayout>

                <!-- Quick Login Divider -->
                <LinearLayout
                    android:id="@+id/layout_quick_login_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/surface_container_highest" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="hoặc đăng nhập nhanh"
                        android:textColor="@color/outline"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/surface_container_highest" />
                </LinearLayout>

                <!-- Secondary CTA: Biometric Login -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_biometric"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/tertiary_fixed"
                    android:text="Đăng nhập bằng sinh trắc học"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_container"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_dialog_info"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/primary_container" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security & Trust Indicators Bar -->
        <LinearLayout
            android:id="@+id/layout_security_badges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_locked"
            android:backgroundTint="@color/surface_container_low"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_login_floating">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã hóa SSL 256-bit"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="•"
                android:textColor="@color/outline_variant"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chống gian lận AI"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer Area: eKYC Registration & Certifications -->
        <LinearLayout
            android:id="@+id/layout_login_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_security_badges">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có tài khoản?"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_open_ekyc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Mở tài khoản eKYC ngay ›"
                    android:textColor="@color/secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Bảo mật đa tầng FIDO2 • PCI-DSS Level 1"
                android:textColor="@color/outline"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Phiên bản 1.0.0 (TDTU Build)"
                android:textColor="@color/outline"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>