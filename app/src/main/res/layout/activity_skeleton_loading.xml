<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_neutral_surface"
    tools:context=".SkeletonLoadingActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- Top Hero Header with Arch Curve -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/tdt_brand_primary"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="56dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Top Bar: Avatar & Brand / Actions -->
                <View
                    android:id="@+id/skeleton_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_skeleton_circle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/skeleton_greeting"
                    android:layout_width="80dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_skeleton"
                    app:layout_constraintStart_toEndOf="@id/skeleton_avatar"
                    app:layout_constraintTop_toTopOf="@id/skeleton_avatar" />

                <View
                    android:id="@+id/skeleton_username"
                    android:layout_width="128dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_skeleton"
                    app:layout_constraintStart_toStartOf="@id/skeleton_greeting"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_greeting" />

                <!-- Right actions -->
                <View
                    android:id="@+id/skeleton_notification"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_skeleton_circle"
                    app:layout_constraintEnd_toStartOf="@id/skeleton_search"
                    app:layout_constraintTop_toTopOf="@id/skeleton_avatar" />

                <View
                    android:id="@+id/skeleton_search"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_skeleton_circle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/skeleton_avatar" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Primary Account Card (Floating) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/account_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/header_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top row: Account label & Eye toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_skeleton_circle" />

                        <View
                            android:layout_width="112dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_skeleton" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="auto"
                            android:background="@drawable/bg_skeleton_circle" />
                    </LinearLayout>

                    <!-- Main Balance -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="16dp"
                        android:layout_weight="0.65"
                        android:background="@drawable/bg_skeleton" />

                    <!-- Secondary Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="96dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_skeleton" />

                        <View
                            android:layout_width="64dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_skeleton" />
                    </LinearLayout>

                    <!-- Quick Action Buttons (4 items) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="48dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="48dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="48dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="48dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Status Card with Spinner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/status_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/account_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Spinner -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_spinner_track" />

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_spinner_loading" />
                    </FrameLayout>

                    <!-- Status Text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/skeleton_loading_title"
                            android:textColor="@color/tdt_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_status_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/skeleton_loading_subtitle"
                            android:textColor="@color/tdt_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- My Accounts Section -->
            <LinearLayout
                android:id="@+id/accounts_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/status_card">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="144dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="auto"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <!-- 2 Account Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_skeleton" />

                                <View
                                    android:layout_width="48dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="auto"
                                    android:background="@drawable/bg_skeleton" />
                            </LinearLayout>

                            <View
                                android:layout_width="80dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_skeleton" />

                            <View
                                android:layout_width="96dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_skeleton" />

                                <View
                                    android:layout_width="48dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="auto"
                                    android:background="@drawable/bg_skeleton" />
                            </LinearLayout>

                            <View
                                android:layout_width="80dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_skeleton" />

                            <View
                                android:layout_width="96dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Utilities Grid -->
            <LinearLayout
                android:id="@+id/utilities_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/accounts_section">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="112dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="auto"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <!-- Grid Container -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:padding="16dp"
                        android:rowCount="2">

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_skeleton_circle" />

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton" />
                        </LinearLayout>
                    </GridLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Recent Transactions -->
            <LinearLayout
                android:id="@+id/transactions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/utilities_section">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="160dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="auto"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <!-- Transaction Rows -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_skeleton_circle" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <View
                                        android:layout_width="128dp"
                                        android:layout_height="14dp"
                                        android:background="@drawable/bg_skeleton" />

                                    <View
                                        android:layout_width="80dp"
                                        android:layout_height="10dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="80dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/bg_skeleton" />

                                <View
                                    android:layout_width="48dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_skeleton" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_skeleton_circle" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <View
                                        android:layout_width="112dp"
                                        android:layout_height="14dp"
                                        android:background="@drawable/bg_skeleton" />

                                    <View
                                        android:layout_width="64dp"
                                        android:layout_height="10dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="96dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/bg_skeleton" />

                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_skeleton" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_skeleton_circle" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
