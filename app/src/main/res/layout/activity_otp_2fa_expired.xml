<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_surface"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
            <ImageButton android:id="@+id/button_otp_expired_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_arrow_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Xác Thực Giao Dịch (2FA)" android:textColor="@color/tdt_on_surface" android:textSize="20sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/button_otp_expired_help" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Trợ giúp và bảo mật" android:padding="10dp" android:src="@drawable/ic_shield_info" />
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_otp_avatar"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_person" android:tint="@color/tdt_on_primary" /></FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="8dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_error_icon_container"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_warning" android:tint="@color/tdt_error" /></FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Xác thực bảo mật 2FA" android:textColor="@color/tdt_on_surface" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mã xác thực gửi đến số điện thoại 0909 *** 888" android:textColor="@color/tdt_on_surface_variant" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_otp_card" android:elevation="2dp" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_empty" android:gravity="center" android:text="–" android:textColor="@color/tdt_on_surface_variant" android:textSize="24sp" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_empty" android:gravity="center" android:text="–" android:textColor="@color/tdt_on_surface_variant" android:textSize="24sp" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_empty" android:gravity="center" android:text="–" android:textColor="@color/tdt_on_surface_variant" android:textSize="24sp" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_empty" android:gravity="center" android:text="–" android:textColor="@color/tdt_on_surface_variant" android:textSize="24sp" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_empty" android:gravity="center" android:text="–" android:textColor="@color/tdt_on_surface_variant" android:textSize="24sp" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_empty" android:gravity="center" android:text="–" android:textColor="@color/tdt_on_surface_variant" android:textSize="24sp" /></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_error_alert_banner" android:orientation="horizontal" android:padding="8dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_warning" android:tint="@color/tdt_error" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mã OTP đã hết hiệu lực (00:00)" android:textColor="@color/tdt_error" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Thời gian chờ 60 giây đã kết thúc. Vui lòng nhấn nhận mã mới để đảm bảo an toàn giao dịch." android:textColor="@color/tdt_on_error_container" android:textSize="12sp" /></LinearLayout></LinearLayout>
                <Button android:id="@+id/button_otp_resend_new" style="@style/Widget.TDT.Button.Primary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="Gửi lại mã OTP mới" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_otp_card" android:elevation="2dp" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHI TIẾT GIAO DỊCH CHỜ  •  TẠM DỪNG" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Loại giao dịch                                      Chuyển tiền nhanh 24/7&#10;Số tiền chuyển                                         15.000.000 đ&#10;Người nhận                                 NGUYEN VAN TAI&#10;                                                         1903 8888 6666" android:textColor="@color/tdt_on_surface" android:textSize="13sp" android:lineSpacingExtra="7dp" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_otp_card" android:elevation="2dp" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TDT SecKey Guard                                      Tạm khóa" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:alpha="0.5" android:columnCount="3" android:rowCount="4" android:useDefaultMargins="true"><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="3" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="8" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="1" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="9" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="0" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="4" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="6" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="2" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="7" /><ImageButton android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="@drawable/bg_otp_key_aux" android:contentDescription="Xáo trộn" android:enabled="false" android:src="@drawable/ic_security" /><Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:enabled="false" android:text="5" /><ImageButton android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="@drawable/bg_otp_key_aux" android:contentDescription="Xóa" android:enabled="false" android:src="@drawable/ic_backspace" /></GridLayout></LinearLayout>
            <Button android:id="@+id/button_otp_expired_change_method" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:background="@color/tdt_surface_container_high" android:text="Đổi sang Smart OTP hoặc Sinh trắc học" android:textColor="@color/tdt_brand_primary" android:textSize="14sp" android:textStyle="bold" />
            <Button android:id="@+id/button_otp_expired_cancel" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:text="Hủy bỏ giao dịch này" android:textColor="@color/tdt_error" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Bảo mật bởi TDT Shield™ • Tiêu chuẩn PCI-DSS Level 1" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
