<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_error_500_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_neutral_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Central Incident & Safety Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_error_500_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tdt_neutral_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/tdt_neutral_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Top Brand Accent Bar -->
                <View
                    android:id="@+id/view_top_accent_bar"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_status_top_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Error Icon Badge -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_status_error_pill">

                        <ImageView
                            android:id="@+id/iv_error_500_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="Lỗi hệ thống"
                            android:src="@android:drawable/stat_notify_error"
                            app:tint="@color/tdt_error" />
                    </FrameLayout>

                    <!-- Error Code Pill Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_status_error_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_error_pill"
                            android:backgroundTint="@color/tdt_error" />

                        <TextView
                            android:id="@+id/tv_error_code_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.04"
                            android:text="MÃ LỖI: ERR_500 (SERVER_TIMEOUT)"
                            android:textColor="@color/tdt_on_error_container"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tv_error_500_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="Hệ thống đang bảo trì tạm thời"
                        android:textColor="@color/tdt_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Reassurance Description -->
                    <TextView
                        android:id="@+id/tv_error_500_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:maxWidth="320dp"
                        android:text="Đã xảy ra sự cố kỹ thuật ngoài ý muốn trong quá trình xử lý yêu cầu. Đội ngũ kỹ thuật TDT Bank đang khắc phục. Tiền và tài khoản của bạn luôn được bảo vệ tuyệt đối an toàn."
                        android:textColor="@color/tdt_text_secondary"
                        android:textSize="14sp" />

                    <!-- Safeguard Status Pill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_status_info_box"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Bảo mật"
                            android:src="@android:drawable/ic_secure"
                            app:tint="@color/tdt_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Tài sản của bạn được bảo mật tuyệt đối 100%"
                            android:textColor="@color/tdt_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Technical Metadata Box (L2 Info Box) -->
                    <LinearLayout
                        android:id="@+id/layout_error_500_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:background="@drawable/bg_status_info_box"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Row 1: Timestamp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Thời gian phát sinh:"
                                android:textColor="@color/tdt_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_error_timestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="23/11/2026 - 09:35:12"
                                android:textColor="@color/tdt_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/tdt_surface_container_highest" />

                        <!-- Row 2: Session / Trace ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mã phiên giao dịch:"
                                android:textColor="@color/tdt_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_error_trace_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="TR-99482-SYS"
                                android:textColor="@color/tdt_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/tdt_surface_container_highest" />

                        <!-- Row 3: Transaction Status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Trạng thái giao dịch:"
                                android:textColor="@color/tdt_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_skeleton_pill"
                                android:backgroundTint="@color/tdt_surface_container_highest"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp">

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_skeleton_pill"
                                    android:backgroundTint="@color/tdt_secondary" />

                                <TextView
                                    android:id="@+id/tv_error_tx_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Chưa ghi nợ tài khoản (Safe)"
                                    android:textColor="@color/tdt_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Primary Action: Retry -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_error_retry"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/tdt_brand_primary"
                        android:text="Thử lại giao dịch"
                        android:textAllCaps="false"
                        android:textColor="@color/tdt_on_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_popup_sync"
                        app:iconGravity="textStart"
                        app:iconTint="@color/tdt_on_primary" />

                    <!-- Secondary Action: Go Home -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_error_go_home"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/tdt_primary_fixed"
                        android:text="Quay về trang chủ"
                        android:textAllCaps="false"
                        android:textColor="@color/tdt_on_primary_fixed_variant"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_myplaces"
                        app:iconGravity="textStart"
                        app:iconTint="@color/tdt_on_primary_fixed_variant" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 24/7 Emergency Support Footer -->
        <LinearLayout
            android:id="@+id/layout_error_500_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Hỗ trợ"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="@color/tdt_brand_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Cần trợ giúp ngay?"
                    android:textColor="@color/tdt_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_hotline_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gọi Hotline 1900 8888"
                    android:textColor="@color/tdt_brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_skeleton_placeholder"
                    android:backgroundTint="@color/tdt_primary_fixed"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="MIỄN PHÍ"
                    android:textColor="@color/tdt_brand_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Đội ngũ CSKH ưu tiên bảo vệ tài khoản hoạt động 24/7"
                android:textColor="@color/tdt_outline"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>