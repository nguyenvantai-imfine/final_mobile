<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:paddingHorizontal="16dp"
    android:paddingVertical="32dp"
    tools:context=".ui.auth.SplashActivity">

    <!-- Center Identity Core -->
    <LinearLayout
        android:id="@+id/layout_center_identity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 96x96dp Shield Logo Container + Verified Badge -->
        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_splash_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="26dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_splash_shield"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:contentDescription="TDT Bank Shield Logo"
                    android:src="@drawable/ic_tdt_shield_logo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Verified Security Sparkle Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                app:cardBackgroundColor="@color/secondary_container"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Verified Security"
                    android:src="@android:drawable/ic_secure"
                    app:tint="@color/on_primary" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Brand Typography Header -->
        <TextView
            android:id="@+id/tv_splash_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="TDT BANK"
            android:textColor="@color/surface_container_lowest"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Slogan -->
        <TextView
            android:id="@+id/tv_splash_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ngân hàng số thế hệ mới"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp" />

        <!-- Trust & Cryptographic Security Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_translucent_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Lock Icon"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#E6FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.04"
                android:text="PCI-DSS LEVEL 1 • FIDO2"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Interactive Connection Bar & Metadata -->
    <LinearLayout
        android:id="@+id/layout_bottom_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Minimalist Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_splash"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="72"
            app:indicatorColor="@color/surface_container_lowest"
            app:trackColor="#33FFFFFF"
            app:trackCornerRadius="999dp"
            app:trackThickness="4dp" />

        <!-- Dynamic Status Feedback -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_splash_status"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_pill_translucent_white"
                android:backgroundTint="@color/secondary_fixed" />

            <TextView
                android:id="@+id/tv_splash_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Đang khởi tạo kết nối an toàn..."
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Versioning & Legal Authority -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="Phiên bản v1.0.0 (TDTU Build)"
            android:textColor="@color/surface_container_lowest"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.6"
            android:text="© 2026 TDT Bank. All rights reserved."
            android:textColor="@color/surface_container_lowest"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>