<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_surface"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
            <ImageButton android:id="@+id/button_otp_error_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_arrow_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Xác Thực Giao Dịch (2FA)" android:textColor="@color/tdt_on_surface" android:textSize="20sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/button_otp_error_help" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Trợ giúp và bảo mật" android:padding="10dp" android:src="@drawable/ic_shield_info" />
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_otp_avatar"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_person" android:tint="@color/tdt_on_primary" /></FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="8dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_error_icon_container"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_error_filled" /></FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Xác thực bảo mật 2FA" android:textColor="@color/tdt_on_surface" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Mã xác thực gồm 6 số đã được gửi qua SMS đến số điện thoại 0909 *** 888" android:textAlignment="center" android:textColor="@color/tdt_on_surface_variant" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_otp_card" android:elevation="2dp" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_error" android:gravity="center" android:text="4" android:textColor="@color/tdt_error" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_error" android:gravity="center" android:text="7" android:textColor="@color/tdt_error" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_error" android:gravity="center" android:text="2" android:textColor="@color/tdt_error" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_error" android:gravity="center" android:text="1" android:textColor="@color/tdt_error" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_error" android:gravity="center" android:text="9" android:textColor="@color/tdt_error" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_otp_slot_error" android:gravity="center" android:text="0" android:textColor="@color/tdt_error" android:textSize="18sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_error_alert_banner" android:orientation="horizontal" android:padding="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_error_filled" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mã xác thực không chính xác. Quý khách còn lại 2 lần thử" android:textColor="@color/tdt_on_error_container" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Mã tham chiếu: OTP_INVALID_002" android:textColor="@color/tdt_error" android:textSize="11sp" /></LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gửi lại mã sau 0:34" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><Button android:id="@+id/button_otp_smart_otp" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@android:color/transparent" android:text="Nhận qua Smart OTP" android:textColor="@color/tdt_brand_primary" android:textSize="12sp" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_otp_card" android:elevation="2dp" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_otp_waiting_badge" android:padding="8dp" android:text="CHUYỂN TIỀN NỘI BỘ NHANH 24/7  •  CHỜ 2FA" android:textColor="@color/tdt_on_secondary_fixed" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tổng số tiền" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15.000.000 đ" android:textColor="@color/tdt_brand_primary" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/tdt_surface_container_low" android:padding="8dp" android:text="Người thụ hưởng  •  NGUYEN VAN TAI&#10;Số tài khoản       •  1903 8888 6666&#10;Ngân hàng          •  TDT Bank - Chi nhánh Thủ Đức" android:textColor="@color/tdt_on_surface" android:textSize="12sp" android:lineSpacingExtra="5dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@color/tdt_surface_container_high" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bàn phím bảo mật TDT SecKey™  •  Xáo trộn ngẫu nhiên" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" android:textStyle="bold" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:columnCount="3" android:rowCount="4" android:useDefaultMargins="true"><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="3" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="8" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="1" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="5" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="9" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="2" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="7" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="0" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="4" /><ImageButton android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:background="@drawable/bg_otp_key_aux" android:contentDescription="Sinh trắc học" android:padding="12dp" android:src="@drawable/ic_fingerprint" /><Button android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="6" /><ImageButton android:id="@+id/button_otp_error_backspace" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:background="@drawable/bg_otp_key_aux" android:contentDescription="Xóa" android:padding="12dp" android:src="@drawable/ic_backspace" /></GridLayout>
            </LinearLayout>
            <Button android:id="@+id/button_otp_retry" style="@style/Widget.TDT.Button.Primary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Nhập lại mã xác thực" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal"><Button android:id="@+id/button_otp_change_method" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@color/tdt_surface_container_low" android:text="Đổi phương thức" android:textColor="@color/tdt_brand_primary" android:textSize="12sp" /><Button android:id="@+id/button_otp_cancel" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@color/tdt_surface_container_low" android:text="Hủy giao dịch" android:textColor="@color/tdt_error" android:textSize="12sp" /></LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Mã hóa E2EE 256-bit • TDT Shield™ PKI" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
