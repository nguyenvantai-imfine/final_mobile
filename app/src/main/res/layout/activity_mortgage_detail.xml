<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_surface"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/tdt_primary_container" android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
        <ImageButton android:id="@+id/btn_back_mortgage" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_arrow_back" android:tint="@color/tdt_on_primary" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chi Tiết Tài Khoản" android:textColor="@color/tdt_on_primary" android:textSize="18sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/btn_more_mortgage" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Tùy chọn khoản vay" android:padding="10dp" android:src="@drawable/ic_arrow_outward" android:tint="@color/tdt_on_primary" />
        <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_circle_primary"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_person" android:tint="@color/tdt_on_primary" /></FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.TDT.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_receipt_long" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Hợp đồng:" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_contract_code" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:text="MTG-2026-089" android:textColor="@color/tdt_on_surface" android:textSize="12sp" android:textStyle="bold" /><ImageButton android:id="@+id/btn_copy_mortgage_code" android:layout_width="36dp" android:layout_height="36dp" android:background="@android:color/transparent" android:contentDescription="Sao chép mã hợp đồng" android:padding="8dp" android:src="@drawable/ic_arrow_outward" /></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dư nợ còn lại" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_status_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_badge" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="• Đúng hạn" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /></LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="bottom"><TextView android:id="@+id/tv_mortgage_remaining_principal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="420.000.000" android:textColor="@color/tdt_error" android:textSize="32sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="đ" android:textColor="@color/tdt_error" android:textSize="16sp" android:textStyle="bold" /></LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Khoản nợ còn lại phải hoàn trả cho ngân hàng" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@color/tdt_surface_container_low" android:orientation="vertical" android:padding="10dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khoản vay gốc" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_initial_limit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="600.000.000 đ" android:textColor="@color/tdt_on_surface" android:textSize="16sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã thanh toán" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_paid_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="180.000.000 đ (30%)" android:textColor="@color/tdt_success" android:textSize="16sp" android:textStyle="bold" /></LinearLayout></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lãi suất ưu đãi" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_current_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.5%/năm" android:textColor="@color/tdt_brand_primary" android:textSize="16sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thời hạn vay" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_loan_term" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 năm" android:textColor="@color/tdt_on_surface" android:textSize="16sp" android:textStyle="bold" /></LinearLayout></LinearLayout></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal"><TextView android:id="@+id/tv_mortgage_repayment_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✓ Tiến độ trả nợ: 30%" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_remaining_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Còn lại 70%" android:textColor="@color/tdt_brand_primary" android:textSize="12sp" android:textStyle="bold" /></LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_mortgage_repayment" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:progress="30" app:indicatorColor="@color/tdt_brand_primary" app:trackColor="@color/tdt_surface_container_highest" app:trackCornerRadius="999dp" />
                    <TextView android:id="@+id/tv_mortgage_paid_months" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Đã trả 36/120 tháng" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_mortgage_floating_margin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Biên độ +3.2% thả nổi" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/tdt_surface_container_low" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_chip_selected"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_account_balance" /></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/tv_collateral_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tài sản: Căn hộ Diamond Riverside B-14.02" android:textColor="@color/tdt_on_surface" android:textSize="12sp" android:textStyle="bold" /><TextView android:id="@+id/tv_collateral_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quận 7, TP. Hồ Chí Minh" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /></LinearLayout></LinearLayout>
            <TextView android:id="@+id/tv_collateral_valuation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="end" android:text="Định giá: 1.250.000.000 đ" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /><TextView android:id="@+id/tv_collateral_ltv" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="🛡 48% (Rất an toàn)" android:textColor="@color/tdt_success" android:textSize="11sp" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.TDT.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kỳ thanh toán số 37" android:textColor="@color/tdt_on_surface" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/tv_mortgage_days_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_error_pill" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="Còn 4 ngày" android:textColor="@color/tdt_error" android:textSize="11sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp" android:background="@color/tdt_surface_container" android:orientation="horizontal" android:padding="3dp"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/tdt_primary_container" android:gravity="center" android:text="Theo tháng" android:textColor="@color/tdt_on_primary" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Mỗi 2 tuần" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@color/tdt_surface_container_lowest" android:orientation="vertical" android:padding="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng số tiền phải trả kỳ này" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_next_total_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6.450.000 đ" android:textColor="@color/tdt_brand_primary" android:textSize="28sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hạn cuối nộp" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /><TextView android:id="@+id/tv_mortgage_next_due_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05/12/2026" android:textColor="@color/tdt_warning" android:textSize="14sp" android:textStyle="bold" /></LinearLayout></LinearLayout><TextView android:id="@+id/tv_mortgage_next_principal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tiền gốc kỳ 37: 3.500.000 đ" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:id="@+id/tv_mortgage_next_interest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiền lãi tạm tính: 2.950.000 đ" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phí quản lý tài khoản vay: Miễn phí" android:textColor="@color/tdt_success" android:textSize="12sp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@color/tdt_surface_container_low" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp"><TextView android:id="@+id/tv_mortgage_auto_debit_source" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TK TDT 1903 •••• 8829" android:textColor="@color/tdt_on_surface" android:textSize="12sp" /><com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_mortgage_auto_debit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Tự động trích nợ" android:textSize="11sp" /></LinearLayout><TextView android:id="@+id/tv_mortgage_rate_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="ⓘ Áp dụng lãi suất ưu đãi 8.5%/năm" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /><com.google.android.material.button.MaterialButton android:id="@+id/btn_pay_mortgage_now" style="@style/Widget.TDT.Button.Primary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Thanh toán kỳ này ngay" /></LinearLayout></com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lịch trả nợ sắp tới" android:textColor="@color/tdt_on_surface" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/tv_mortgage_installment_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="36/120 kỳ" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /></LinearLayout><Button android:id="@+id/btn_view_amortization_schedule" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@android:color/transparent" android:text="Xem tất cả 120 kỳ" android:textColor="@color/tdt_secondary" android:textSize="12sp" android:textStyle="bold" /></LinearLayout>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TDT.Card" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/tdt_soft_highlight" android:padding="12dp" android:text="Kỳ 37/120     • Kỳ kế tiếp • Hạn: 05/12/2026     6.450.000 đ" android:textColor="@color/tdt_on_surface" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Kỳ 38/120     • Sắp tới • Hạn: 05/01/2027          6.425.000 đ" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Kỳ 39/120     • Sắp tới • Hạn: 05/02/2027          6.400.000 đ" android:textColor="@color/tdt_on_surface_variant" android:textSize="12sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Lịch sử thanh toán gần đây" android:textColor="@color/tdt_on_surface" android:textSize="16sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_mortgage_recent_payments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@color/tdt_surface_container_low" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp"><FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_surface_low"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_support_agent" /></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/tv_loan_officer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chuyên viên quản lý khoản vay" android:textColor="@color/tdt_on_surface" android:textSize="12sp" android:textStyle="bold" /><TextView android:id="@+id/tv_loan_officer_branch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nguyễn Hoàng Sơn • Phòng Tín dụng BĐS" android:textColor="@color/tdt_on_surface_variant" android:textSize="11sp" /></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/btn_call_loan_officer" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Liên hệ" android:textSize="12sp" /></LinearLayout>
            <Button android:id="@+id/btn_chat_loan_officer" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:text="Nhắn tin với chuyên viên" android:textColor="@color/tdt_brand_primary" android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
