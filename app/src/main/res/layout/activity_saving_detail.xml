<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_saving_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_surface">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_saving_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tdt_surface_container_lowest"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back_saving"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/tdt_on_surface" />

            <TextView
                android:id="@+id/tv_saving_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="B02 • Chi Tiết Tài Khoản Tiết Kiệm"
                android:textColor="@color/tdt_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_more_saving"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Thao tác"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/tdt_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_saving_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Top Hero Card: Savings Account Overview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_saving_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Badges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_12_surface_low"
                            android:backgroundTint="@color/tdt_surface_container_high"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="• Tiết kiệm có kỳ hạn"
                            android:textColor="@color/tdt_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_saving_detail_rate_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_circle_primary_fixed"
                            android:backgroundTint="#F4DCE9"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="★ Lãi suất 5.80%/năm"
                            android:textColor="@color/tdt_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Title & Account Number Copy -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="TIẾT KIỆM ĐIỆN TỬ TDT PLUS"
                                android:textAllCaps="true"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_saving_detail_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum, zero"
                                    android:text="1903 9999 1111"
                                    android:textColor="@color/tdt_on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/btn_copy_saving_detail"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Sao chép số tài khoản"
                                    android:padding="4dp"
                                    android:src="@android:drawable/ic_menu_save"
                                    app:tint="@color/tdt_on_surface_variant" />
                            </LinearLayout>
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_primary_fixed">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_my_calendar"
                                app:tint="@color/tdt_primary" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Deposit Balance & Projected Interest -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Số dư gốc gửi"
                        android:textColor="@color/tdt_on_surface_variant"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_saving_detail_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:text="30.000.000"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="đ"
                            android:textColor="@color/tdt_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_12_surface_low"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lãi dự tính: "
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_saving_projected_interest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum, zero"
                                android:text="+1.740.000 đ"
                                android:textColor="@color/tdt_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Progress Duration Gauge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_saving_elapsed_term"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thời gian: 3 tháng / 12 tháng"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_saving_term_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25% kỳ hạn"
                            android:textColor="@color/tdt_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_saving_term"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:progress="25"
                        app:indicatorColor="@color/tdt_brand_primary"
                        app:trackColor="@color/tdt_surface_container"
                        app:trackCornerRadius="999dp"
                        app:trackThickness="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_saving_start_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bắt đầu (15/08/2026)"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_saving_end_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đáo hạn (15/08/2027)"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Detailed Contract Specifications -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_saving_specs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Thông tin hợp đồng tiền gửi"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày mở sổ"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_saving_opened_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15/08/2026"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày đáo hạn"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_saving_due_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15/08/2027"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_saving_term_months_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(12 tháng)"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Phương thức trả lãi"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_saving_payout_method"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cuối kỳ"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chỉ thị đáo hạn"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_saving_renewal_instruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_12_surface_low"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Tự động tái tục cả gốc &amp; lãi"
                            android:textColor="@color/tdt_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tài khoản thụ hưởng"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_saving_beneficiary_account"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum, zero"
                                android:text="1903 8888 6666"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(Tài khoản thanh toán)"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lãi suất thực nhận"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_saving_effective_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum, zero"
                            android:text="5.80% / năm (Cố định)"
                            android:textColor="@color/tdt_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Interest Accrual Schedule & Metrics -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_saving_interest_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dự tính sinh lời định kỳ"
                            android:textColor="@color/tdt_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_saving_accrued_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90 ngày gửi"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Dual Metric Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_12_surface_low"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lãi tích lũy hiện tại"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_saving_accrued_interest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFeatureSettings="tnum, zero"
                                android:text="435.000 đ"
                                android:textColor="@color/tdt_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_saving_accrued_note"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Sinh lời sau 3 tháng"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_12_surface_low"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lợi tức ước tính"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_saving_monthly_profit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFeatureSettings="tnum, zero"
                                android:text="~145.000 đ"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Mỗi chu kỳ tháng"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Cashflow Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_12_surface_low"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_rounded_12_surface_low"
                            android:backgroundTint="@color/tdt_surface_container_lowest">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="@color/tdt_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dòng tiền đều đặn"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thu nhập thụ động chuẩn xác"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Action Management Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_saving_topup"
                style="@style/Widget.TDT.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Gửi thêm tiền vào sổ"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_saving_change_renewal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Đổi phương thức tái tục / đáo hạn"
                android:textAllCaps="false"
                android:textColor="@color/tdt_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tdt_surface_container_lowest"
                app:cornerRadius="12dp"
                app:strokeColor="@color/tdt_neutral_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_saving_early_withdraw"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="Tất toán trước hạn (Rút tiền về nguồn)"
                android:textAllCaps="false"
                android:textColor="@color/tdt_error"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Lưu ý: Rút trước hạn sẽ áp dụng lãi suất không kỳ hạn 0.2%/năm đối với toàn bộ thời gian gửi."
                android:textColor="@color/tdt_error"
                android:textSize="11sp" />

            <!-- 5. Deposit Insurance & Security Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_12_surface_low"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_surface_low"
                    android:backgroundTint="@color/tdt_surface_container_lowest">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_24"
                        app:tint="@color/tdt_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chứng chỉ tiền gửi điện tử an toàn"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Được bảo hiểm tiền gửi quốc gia &amp; mã hóa đa tầng bởi TDT Bank"
                        android:textColor="@color/tdt_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>