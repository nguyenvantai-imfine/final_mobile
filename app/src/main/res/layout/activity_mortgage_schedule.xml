<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_mortgage_schedule"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_surface">

    <!-- Top App Bar (Primary Container Header) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_mortgage_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tdt_primary_container"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back_schedule"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/tdt_on_primary" />

            <TextView
                android:id="@+id/tv_schedule_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Customer Mortgage Schedule"
                android:textColor="@color/tdt_on_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_download_schedule"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tải xuống lịch trả nợ"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/tdt_on_primary" />

            <FrameLayout
                android:id="@+id/avatar_schedule_user"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_circle_primary_fixed"
                android:backgroundTint="@color/tdt_primary">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Khách hàng"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/tdt_on_primary" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_mortgage_schedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Khu vực B: Summary Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_schedule_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Contract ID + Term Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_schedule_contract_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🛡 Mã HĐ: MTG-2026-089"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_schedule_term_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_circle_primary_fixed"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="120 kỳ (10 năm)"
                            android:textColor="@color/tdt_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Linear Progress Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_schedule_completion_percent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tiến độ hoàn thành: 30%"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_schedule_installment_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="36/120 kỳ"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_schedule_completion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:progress="30"
                        app:indicatorColor="@color/tdt_primary_container"
                        app:trackColor="@color/tdt_surface_container"
                        app:trackCornerRadius="999dp"
                        app:trackThickness="8dp" />

                    <!-- 3 Key Metric Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã trả"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_schedule_paid_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="36 kỳ"
                                android:textColor="#2E9E5B"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Còn lại"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_schedule_remaining_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="84 kỳ"
                                android:textColor="@color/tdt_on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lãi suất vay"
                                android:textColor="@color/tdt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_schedule_interest_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="8.5%/năm"
                                android:textColor="@color/tdt_secondary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Next Due Highlight Sub-Banner -->
                    <LinearLayout
                        android:id="@+id/banner_next_installment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_rounded_12_surface_low"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_primary_fixed">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_my_calendar"
                                app:tint="@color/tdt_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_schedule_next_due_meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kỳ kế tiếp: Kỳ 37/120 • Hạn 05/12/2026"
                                android:textColor="@color/tdt_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_schedule_next_due_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFeatureSettings="tnum, zero"
                                android:text="Số tiền: 6.450.000 đ"
                                android:textColor="@color/tdt_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Khu vực C: Quick Filters & Year Selector -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_schedule_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_all"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tất cả (120)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_due"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đến hạn / Sắp tới (1)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_paid"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã thanh toán (36)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_overdue"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Quá hạn (0)" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Year Selector Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_schedule_year"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Năm 2026 (Kỳ 37–48) ⌄"
                    android:textAllCaps="false"
                    android:textColor="@color/tdt_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/tdt_surface_container_lowest"
                    app:cornerRadius="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_schedule_year_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum, zero"
                    android:text="Tổng năm 2026: 77.400.000 đ"
                    android:textColor="@color/tdt_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Khu vực D: Installment List (RecyclerView + Empty State) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_installment_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4" />

            <!-- Empty State (e.g. Overdue = 0) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_schedule_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_primary_fixed">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield_24"
                            app:tint="@color/tdt_primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_schedule_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Không có kỳ quá hạn"
                        android:textColor="@color/tdt_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_schedule_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tuyệt vời! Bạn luôn duy trì lịch sử thanh toán hoàn hảo tại TDT Sovereign Elite."
                        android:textColor="@color/tdt_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Utility & Export Action -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_schedule_rule_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/tdt_surface_container_lowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/tdt_neutral_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ⓘ Quy tắc tính toán"
                            android:textColor="@color/tdt_on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Core Banking v4.2"
                            android:textColor="@color/tdt_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Lịch trả nợ tính trên phương pháp dư nợ giảm dần thực tế. Lãi suất có thể điều chỉnh định kỳ theo thông báo chính thức từ TDT Sovereign Elite."
                        android:textColor="@color/tdt_on_surface_variant"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export_schedule_120"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="⬇ Xuất bảng sao kê 120 kỳ (PDF / Excel)"
                        android:textAllCaps="false"
                        android:textColor="@color/tdt_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/tdt_surface_container_low"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>