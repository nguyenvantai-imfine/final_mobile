<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TDTBankSovereign" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tdt_brand_primary</item>
        <item name="colorOnPrimary">@color/tdt_on_primary</item>
        <item name="colorPrimaryContainer">@color/tdt_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/tdt_on_primary_container</item>
        <item name="colorSecondary">@color/tdt_secondary</item>
        <item name="colorOnSecondary">@color/tdt_on_secondary</item>
        <item name="android:colorBackground">@color/tdt_neutral_bg</item>
        <item name="colorSurface">@color/tdt_neutral_surface</item>
        <item name="colorOnSurface">@color/tdt_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tdt_text_secondary</item>
        <item name="colorOutline">@color/tdt_neutral_border</item>
        <item name="colorError">@color/tdt_error_alert</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TDT.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TDT.Medium</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.TDT.BottomSheet</item>
    </style>

    <style name="Widget.TDT.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">48dp</item>
        <item name="backgroundTint">@color/tdt_brand_primary</item>
        <item name="android:textColor">@color/tdt_on_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TDT.Small</item>
    </style>

    <style name="Widget.TDT.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">48dp</item>
        <item name="strokeColor">@color/tdt_brand_primary</item>
        <item name="android:textColor">@color/tdt_brand_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TDT.Small</item>
    </style>

    <style name="Widget.TDT.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/tdt_brand_primary</item>
        <item name="boxStrokeErrorColor">@color/tdt_error_alert</item>
    </style>

    <style name="Widget.TDT.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/tdt_neutral_surface</item>
        <item name="strokeColor">@color/tdt_neutral_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TDT.Medium</item>
    </style>

    <style name="ThemeOverlay.TDT.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.TDT.BottomSheet</item>
    </style>

    <style name="Widget.TDT.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/tdt_neutral_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TDT.BottomSheet</item>
    </style>

    <style name="TextAppearance.TDT.Currency" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFeatureSettings">tnum, zero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tdt_text_primary</item>
    </style>
</resources>


