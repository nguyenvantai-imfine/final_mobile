<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập mạng cho Firebase Auth & Firestore -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TDTBankSovereign"
        tools:targetApi="31">

        <!-- Màn hình khởi động chính của dự án (Splash + Router kiểm tra phiên) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Đăng nhập -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình chính Khách hàng (ROLE: CUSTOMER) -->
        <activity
            android:name=".ui.customer.CustomerMainActivity"
            android:exported="false" />

        <!-- Màn hình chính Nhân viên (ROLE: OFFICER) -->
        <activity
            android:name=".ui.officer.OfficerMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.officer.CustomerListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.officer.CustomerFormActivity"
            android:exported="false" />

        <activity
            android:name=".ui.officer.InterestRateActivity"
            android:exported="false" />

        <activity
            android:name=".ui.officer.EkycListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.officer.EkycReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.officer.EkycRegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.TransactionHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.ServiceOrderActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.ChatActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.KycStatusActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.InterestRateViewActivity"
            android:exported="false" />

        <!-- FileProvider cho ảnh eKYC chụp bằng camera hệ thống -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>