<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_offline_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tdt_neutral_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Minimalist Top Bar -->
        <RelativeLayout
            android:id="@+id/layout_offline_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_skeleton_pill"
                    android:backgroundTint="@color/tdt_surface_container">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="TDT Bank Shield"
                        android:src="@android:drawable/ic_secure"
                        app:tint="@color/tdt_brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.06"
                    android:text="TDT BANK SHIELD"
                    android:textColor="@color/tdt_outline"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_offline_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_skeleton_pill"
                android:backgroundTint="@color/tdt_surface_container_low"
                android:contentDescription="Đóng thông báo"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/tdt_text_secondary" />
        </RelativeLayout>

        <!-- Central Offline State Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_offline_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tdt_neutral_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/tdt_neutral_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Offline Visual Illustration -->
                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_skeleton_pill"
                        android:backgroundTint="@color/tdt_primary_fixed">

                        <ImageView
                            android:id="@+id/iv_offline_icon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="Mất kết nối mạng"
                            android:src="@android:drawable/stat_notify_error"
                            app:tint="@color/tdt_brand_primary" />
                    </FrameLayout>

                    <!-- Warning Badge Pin -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_skeleton_pill"
                        android:backgroundTint="@color/tdt_error_container">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Cảnh báo kết nối"
                            android:src="@android:drawable/stat_sys_warning"
                            app:tint="@color/tdt_error" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Status Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_status_error_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_skeleton_pill"
                        android:backgroundTint="@color/tdt_error" />

                    <TextView
                        android:id="@+id/tv_offline_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Mất kết nối"
                        android:textColor="@color/tdt_error"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Title & Description -->
                <TextView
                    android:id="@+id/tv_offline_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Không có kết nối Internet"
                    android:textColor="@color/tdt_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_offline_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="320dp"
                    android:text="Vui lòng kiểm tra lại đường truyền Wi-Fi hoặc dữ liệu di động (4G/5G) trên thiết bị của bạn để tiếp tục sử dụng TDT Bank."
                    android:textColor="@color/tdt_text_secondary"
                    android:textSize="14sp" />

                <!-- Quick Troubleshooting Card -->
                <LinearLayout
                    android:id="@+id/layout_offline_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_status_info_box"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Mẹo"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="@color/tdt_brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Mẹo khắc phục nhanh:"
                            android:textColor="@color/tdt_brand_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Kiểm tra hoặc tắt / bật lại Chế độ máy bay"
                        android:textColor="@color/tdt_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Bật lại kết nối Wi-Fi hoặc Dữ liệu di động"
                        android:textColor="@color/tdt_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Primary Action: Retry -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_offline_retry"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/tdt_brand_primary"
                    android:text="Thử lại ngay"
                    android:textAllCaps="false"
                    android:textColor="@color/tdt_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_popup_sync"
                    app:iconGravity="textStart"
                    app:iconTint="@color/tdt_on_primary" />

                <!-- Secondary Action: Hotline -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_offline_hotline"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/tdt_primary_fixed"
                    android:text="Hỗ trợ kỹ thuật: 1900 8888"
                    android:textAllCaps="false"
                    android:textColor="@color/tdt_brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_call"
                    app:iconGravity="textStart"
                    app:iconTint="@color/tdt_brand_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security Footer Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Shield"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="@color/tdt_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Dữ liệu phiên làm việc được bảo vệ an toàn bởi TDT Bank Shield"
                android:textColor="@color/tdt_outline"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>